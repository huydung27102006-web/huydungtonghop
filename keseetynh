[Rule]
# Chặn QUIC/UDP cho Locket, RevenueCat và Firebase để ép chạy TCP (giúp bắt gói tin chuẩn xác)
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT

# Chặn Sentry Telemetry (tránh gửi báo cáo lỗi về nhà phát hành)
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[Header Rewrite]
# Xóa Cache / ETag trên RevenueCat và các API dự phòng
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)\/.+\/(receipts|subscribers) header-del If-Modified-Since

# Xóa Cache / ETag trên Firebase Remote Config
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del x-goog-if-none-match

# Xóa Cache / ETag trên Locket Camera API
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since

[Script]
# Locket Gold - Xóa Header RevenueCat và Firebase
deleteHeader_RC = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/deleteHeader_Firebase.js,timeout=60

deleteHeader_Firebase = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/deleteHeader_RC.js.js,timeout=60

# Locket Gold - Kích hoạt quyền thuê bao và tính năng thời gian dài
revenuecat = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/evenuecat.js,requires-body=true,max-size=-1,timeout=60

locket_rc = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/locketfix.js?v=20261108_10,requires-body=true,max-size=1048576,timeout=10

# Locket Photobooth Engine
locket_pb_req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/locket_pb_req.js?v=20261108_10,requires-body=true,max-size=-1,timeout=60

# Locket Huy hiệu Profile và Mạng lưới bạn bè VIP
locket_change_profile = type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/locket_change_profile.js?v=20261108_10,timeout=60

locket_filter_resp = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Locket%20Filter%20AI/js/locket_filter_resp.js?v=20261108_10,timeout=60

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0
cuios-status.identity = 198.18.0.1

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-production.8-lives-cat.io, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, api.locket.camera, us-central1-locket-4252a.cloudfunctions.net
